<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_background"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintWidth_max="380dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Identidad Institucional -->
            <TextView
                android:id="@+id/tvBrandName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_brand_name"
                android:textSize="14sp"
                android:letterSpacing="0.15"
                android:textColor="@color/zen_crimson"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSystemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_system_title"
                android:textSize="26sp"
                android:textColor="@color/zen_graphite"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"/>

            <!-- Input: Correo o Usuario -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_label_user"
                android:textColor="@color/zen_graphite"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/login_hint_user"
                android:textColor="#000000"
                android:textColorHint="#424242"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:paddingHorizontal="12dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="16dp"/>

            <!-- Input: Contraseña -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_label_password"
                android:textColor="@color/zen_graphite"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/login_hint_password"
                android:textColor="#000000"
                android:textColorHint="#111111"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:paddingHorizontal="12dp"
                android:background="@color/white"
                android:layout_marginBottom="24dp"
                tools:ignore="TextContrastCheck" />

            <!-- Botón Entrar (Corregido 'is too wide' con minWidth y layout_gravity) -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:minWidth="260dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/login_btn_enter"
                android:textColor="@color/white"
                android:backgroundTint="@color/zen_crimson"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Enlace Olvidé contraseña -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:text="@string/login_forgot_password"
                android:textColor="@color/zen_graphite"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp"/>

            <!-- Pie de página de Seguridad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_footer_security"
                android:textColor="#424242"
                android:textSize="11sp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>